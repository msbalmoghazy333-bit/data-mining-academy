# ---------------------------------------------------------------------------
# Data Mining Academy — backend environment variables
# Copy this file to `.env` and adjust the values for your machine.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- General ---
APP_NAME="Data Mining Academy"
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# --- API ---
API_V1_PREFIX=/api
# Comma-separated list of origins allowed by CORS
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- Database (SQLite + SQLAlchemy) ---
DATABASE_URL="sqlite:///./data/dm_academy.db"

# --- Vector store (ChromaDB, local persistence) ---
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=dm_academy_chunks
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Embedding backend selection:
#   auto -> sentence-transformers if installed, else OpenRouter /embeddings
#           (needs OPENROUTER_API_KEY), else chromadb's built-in ONNX MiniLM
#           (~80 MB one-time download, fully offline afterwards)
#   local -> local models only
#   api   -> OpenRouter embeddings only (strongest Arabic quality)
EMBEDDING_BACKEND=auto
# OpenRouter slug used when the backend resolves to "api".
EMBEDDING_API_MODEL=baai/bge-m3

# --- Chunking --------------------------------------------------------------
# Target size for an embedding chunk (words). Must stay inside 500-800.
CHUNK_TARGET_WORDS=650
CHUNK_MAX_WORDS=800
# Slides carry only ~25 words each. When true, consecutive short slides are
# merged so chunks reach the target band; the citation then points at the
# FIRST slide of the merged run. Set to false for strict per-slide citations.
CHUNK_MERGE_SHORT_PAGES=true
# Upper bound on how many slides one merged chunk may cover. Slides average
# ~25 words, so ~20 of them are needed to reach the 500-word target.
CHUNK_MAX_PAGE_SPAN=32

# --- File handling ---
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_TYPES=".pdf,.pptx,.ppt,.docx,.txt,.md"
UPLOAD_DIR=./data/uploads

# --- LLM (OpenRouter, OpenAI-compatible) ------------------------------------
# Get a key from https://openrouter.ai/keys . Without a key, the generation
# endpoints respond with 409 CONFLICT and a clear message.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any OpenRouter model slug works; primary + one fallback on transient errors.
LLM_MODEL=anthropic/claude-3.5-sonnet
LLM_FALLBACK_MODEL=google/gemini-2.0-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=120
# Attribution headers sent to OpenRouter (shown in its dashboard usage page).
OPENROUTER_APP_NAME="Data Mining Academy"
OPENROUTER_APP_URL=http://localhost:5173

# --- RAG tutor ---------------------------------------------------------------
# Chunks fetched per student question (spec: 4-6).
RAG_TOP_K=6
# Conversation turns sent back to the model, capped.
RAG_MAX_HISTORY_MESSAGES=12
RAG_TEMPERATURE=0.2
